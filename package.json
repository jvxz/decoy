{
  "name": "magi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:test": "NITRO_PRESET=node-server NODE_ENV=test pnpm build",
    "dev": "VITE_PLUGIN_PWA=true pnpm dev:no-pwa",
    "dev:no-pwa": "nuxt dev --port 5173",
    "dev:prepare": "nuxt prepare",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "generate": "nuxt generate",
    "knip:fix": "knip --fix",
    "lint": "pnpm oxlint && eslint --ignore-pattern AGENTS.md",
    "lint:fix": "pnpm oxlint --fix && eslint --ignore-pattern AGENTS.md --fix",
    "oxlint": "oxlint .",
    "postinstall": "nuxt prepare",
    "preview": "pnpm run build && nuxt preview --port 5173",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "pnpm build:test && pnpm test:e2e:prebuilt",
    "test:e2e:prebuilt": "playwright test",
    "test:e2e:ui": "pnpm build:test && pnpm test:e2e:prebuilt --ui",
    "test:e2e:webserver": "NODE_ENV=test pnpm exec nuxt preview --port 5678",
    "test:nuxt": "vitest --project nuxt",
    "test:typecheck": "nuxt prepare && vue-tsc -b --noEmit",
    "test:unit": "vitest --project unit",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.5.1",
    "@nuxt/scripts": "1.3.8",
    "@nuxtjs/color-mode": "4.0.1",
    "@nuxtjs/i18n": "10.6.0",
    "@tanstack/query-persist-client-core": "5.102.8",
    "@tanstack/vue-hotkeys": "^0.10.0",
    "@tanstack/vue-query": "5.101.4",
    "@tanstack/vue-virtual": "^3.13.36",
    "@tiptap/extension-emoji": "^3.31.2",
    "@tiptap/extension-mention": "^3.31.2",
    "@tiptap/extension-placeholder": "^3.31.2",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "14.4.0",
    "@vueuse/nuxt": "14.4.0",
    "dompurify": "3.4.7",
    "emojibase": "^17.0.0",
    "emojibase-data": "^17.0.0",
    "es-toolkit": "^1.52.0",
    "idb-keyval": "^6.3.0",
    "marked": "^18.0.11",
    "marked-highlight": "^2.2.4",
    "matrix-js-sdk": "^41.9.0",
    "mime": "^4.1.0",
    "motion-v": "^2.4.0",
    "nuxt": "4.5.2",
    "nuxt-security": "2.6.0",
    "nuxt-tiptap-editor": "3.4.0",
    "nuxt-twemoji": "4.0.6",
    "quick-lru": "^7.3.0",
    "rangi": "^2.2.0",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "temporal-polyfill": "^0.3.2",
    "tiptap-extension-code-block-shiki": "^1.2.0",
    "ufo": "^1.6.4",
    "unstorage": "^1.17.5",
    "valibot": "^1.4.2",
    "virtua": "^0.49.3",
    "vitest-localstorage-mock": "^0.1.2",
    "vue": "3.6.0-rc.6",
    "vue-router": "^5.3.1",
    "workbox-core": "7.4.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "8.3.0",
    "@e18e/eslint-plugin": "^0.5.1",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@faker-js/faker": "10.6.0",
    "@iconify-json/tabler": "1.2.38",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/eslint-plugin": "1.17.0",
    "@nuxt/test-utils": "^4.2.0",
    "@playwright/test": "1.62.1",
    "@regle/nuxt": "1.29.1",
    "@types/grecaptcha": "3.0.9",
    "@types/node": "25.9.5",
    "@unocss/eslint-plugin": "^66.9.2",
    "@unocss/nuxt": "66.9.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/language-core": "3.3.11",
    "@vue/test-utils": "2.5.0",
    "eslint": "^10.9.1",
    "eslint-plugin-antfu": "3.2.3",
    "eslint-plugin-command": "3.5.2",
    "eslint-plugin-oxlint": "^1.81.0",
    "eslint-plugin-perfectionist": "5.9.0",
    "eslint-plugin-regexp": "3.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "happy-dom": "^20.13.2",
    "knip": "^6.34.0",
    "oxfmt": "0.54.0",
    "oxlint": "^1.81.0",
    "pathe": "2.0.3",
    "playwright-core": "1.62.1",
    "taze": "19.17.2",
    "typescript": "6.0.3",
    "unocss": "66.9.2",
    "unocss-preset-animations": "1.3.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-bundle-renderer": "2.3.2",
    "vue-tsc": "3.3.11"
  }
}
